#!/usr/bin/env python3
"""Ghostty entry point: attach the most recent project session, or run an explicit app."""

import fcntl
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import uuid

RESTORE_SCRIPT = Path.home() / '.tmux/plugins/tmux-resurrect/scripts/restore.sh'
# Same lookup as tmux-resurrect's default @resurrect-dir.
SAVE_DIR = (Path.home() / '.tmux/resurrect' if (Path.home() / '.tmux/resurrect').is_dir()
            else Path(os.environ.get('XDG_DATA_HOME') or Path.home() / '.local/share') / 'tmux/resurrect')
# Dedicated app windows and leftover grouped views are not projects to resume.
NON_PROJECT_PREFIXES = ('app-', 'view-')


def tmux(*args):
    return subprocess.run(['tmux', *args], capture_output=True, text=True)


def execute(*args):
    os.execvp('tmux', ['tmux', *args])


def sessions():
    """Return (name, last_attached, activity) rows, or None without a tmux server."""
    result = tmux('list-sessions', '-F', '#{session_name}\t#{session_last_attached}\t#{session_activity}')
    if result.returncode:
        if any(message in result.stderr for message in ('no server running', 'No such file or directory')):
            return None
        raise RuntimeError(result.stderr.strip())
    rows = []
    for line in result.stdout.splitlines():
        name, attached, activity = line.split('\t')
        rows.append((name, int(attached or 0), int(activity or 0)))
    return rows


def saved_session():
    """The session that was current when tmux-resurrect last saved."""
    try:
        for line in (SAVE_DIR / 'last').read_text().splitlines():
            fields = line.split('\t')
            if fields[0] == 'state' and len(fields) > 1:
                return fields[1]
    except OSError:
        pass
    return None


def ensure_server():
    """Start tmux in its own cgroup scope and restore the last save, once per boot."""
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR') or '/tmp')
    # Windows opening together must not both start a server or restore twice.
    with open(runtime / 'dotfiles-tmux.lock', 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if sessions() is not None:
            return False
        # Outside Ghostty's per-window scope, closing that window cannot stop tmux.
        # exit-empty is off in ~/.tmux.conf, so the server stays up with no sessions.
        scoped = shutil.which('systemd-run') and subprocess.run(
            ['systemd-run', '--user', '--scope', '--collect', '--quiet',
             '--unit=tmux-server', '--', 'tmux', 'start-server'],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
        if not scoped:
            tmux('start-server')
        if RESTORE_SCRIPT.is_file() and (SAVE_DIR / 'last').exists():
            # run-shell gives the script $TMUX and blocks until the restore ends.
            tmux('run-shell', shlex.quote(str(RESTORE_SCRIPT)))
        return True


def most_recent(rows, preferred=None):
    projects = [row for row in rows if not row[0].startswith(NON_PROJECT_PREFIXES)]
    if preferred in {row[0] for row in projects}:
        return preferred
    if not projects:
        return None
    return max(projects, key=lambda row: (row[1], row[2]))[0]


def create_session(rows):
    name = re.sub(r'[^A-Za-z0-9_-]+', '-', Path.cwd().name).strip('-_') or 'project'
    existing = {row[0] for row in rows}
    base, suffix = name, 2
    while name in existing:
        name = f'{base}-{suffix}'
        suffix += 1
    # -A: if a window opened concurrently made this session, join it.
    execute('new-session', '-A', '-s', name, '-c', str(Path.cwd()))


def main():
    if sys.argv[1:] == ['--help']:
        print('Usage: dotfiles-tmux [-- COMMAND [ARG ...]]\n'
              'No arguments: attach the most recent session. -- COMMAND: dedicated app session.')
        return
    if not shutil.which('tmux'):
        raise RuntimeError('Missing dependency: tmux')
    # Ghostty may itself have been launched from a tmux pane. Its new terminal
    # is a new client, not a nested tmux instance in the inherited pane.
    os.environ.pop('TMUX', None)
    os.environ.pop('TMUX_PANE', None)
    args = sys.argv[1:]
    if args and (args[0] != '--' or len(args) == 1):
        raise RuntimeError('Expected -- COMMAND [ARG ...]; use --help for usage')
    restored = ensure_server()
    if args:
        # tmux treats bare/trailing semicolons as its own command separators even
        # after --. Pass one shell-command with every application argument quoted.
        # Desktop Exec text is never evaluated as shell syntax.
        execute('new-session', '-s', 'app-' + uuid.uuid4().hex[:12],
                '-c', str(Path.cwd()), '--', 'exec ' + shlex.join(args[1:]))
    rows = sessions() or []
    # Restored sessions have never been attached; prefer the one active at save time.
    target = most_recent(rows, saved_session() if restored else None)
    if target is None:
        create_session(rows)
    execute('attach-session', '-t', '=' + target)


if __name__ == '__main__':
    try:
        main()
    except (EOFError, KeyboardInterrupt):
        pass
    except (OSError, RuntimeError) as error:
        print(f'dotfiles-tmux: {error}', file=sys.stderr)
        sys.exit(1)
