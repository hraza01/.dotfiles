#!/usr/bin/env python3
"""Resume/create tmux project sessions (the `t` command), or run an explicit app.

Sessions live on a dedicated tmux server (socket "dotfiles", or
$DOTFILES_TMUX_SOCKET) so they never mix with a host's own tmux, such as
Cloud Shell's terminal. Inspect it manually with: tmux -L dotfiles ls
"""

import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import uuid

SOCKET = os.environ.get('DOTFILES_TMUX_SOCKET') or 'dotfiles'


def tmux(*args):
    return subprocess.run(['tmux', '-L', SOCKET, *args], capture_output=True, text=True)


def execute(*args):
    os.execvp('tmux', ['tmux', '-L', SOCKET, *args])


def sessions():
    result = tmux('list-sessions', '-F',
                  '#{session_id}\t#{session_name}\t#{session_attached}\t#{session_windows}\t#{session_group}\t#{@dotfiles-view}')
    if result.returncode:
        if any(message in result.stderr for message in ('no server running', 'No such file or directory')):
            return []
        raise RuntimeError(result.stderr.strip())
    rows = []
    for line in result.stdout.splitlines():
        identity, name, attached, windows, group, view = line.split('\t')
        rows.append(dict(id=identity, name=name, attached=int(attached),
                         windows=int(windows), group=group, view=view == '1'))
    for row in rows:
        row['busy'] = sum(other['attached'] for other in rows
                          if other['id'] == row['id'] or
                          (row['group'] and other['group'] == row['group']))
    return [row for row in rows if not row['view']]


def choose(options, prompt, header):
    # User fzf defaults must not change the output format or bind extra actions.
    env = dict(os.environ, FZF_DEFAULT_OPTS='', FZF_DEFAULT_OPTS_FILE='')
    result = subprocess.run(
        ['fzf', '--sync', '--no-multi', '--no-sort', '--layout=reverse', '--border=none',
         '--color=bw', '--no-separator',
         '--info=hidden', '--delimiter=\t', '--with-nth=2..',
         '--bind=ctrl-c:abort,esc:abort', f'--prompt={prompt}', f'--header={header}'],
        input=''.join(f'{key}\t{label}\n' for key, label in options),
        stdout=subprocess.PIPE, text=True, env=env)
    if result.returncode in (1, 130):
        return None
    if result.returncode:
        raise RuntimeError(f'Session chooser exited with status {result.returncode}')
    selected = result.stdout.rstrip('\n').split('\t', 1)[0]
    if selected not in {key for key, _ in options}:
        raise RuntimeError('Unexpected session chooser selection')
    return selected


def create_session():
    default = re.sub(r'[^A-Za-z0-9_-]+', '-', Path.cwd().name).strip('-_') or 'project'
    existing = {row['name'] for row in sessions()}
    base, suffix = default, 2
    while default in existing:
        default = f'{base}-{suffix}'
        suffix += 1
    while True:
        name = input(f'Session name [{default}]: ').strip() or default
        if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_-]*', name):
            print('Use letters, numbers, hyphens or underscores; start with a letter or number.')
            continue
        if name in {row['name'] for row in sessions()}:
            print('That session already exists. Choose another name.')
            continue
        # No -A: a concurrent creator must not silently attach us to their session.
        execute('new-session', '-s', name, '-c', str(Path.cwd()))


def main():
    if sys.argv[1:] == ['--help']:
        print('Usage: dotfiles-tmux [-- COMMAND [ARG ...]]\n'
              'No arguments: resume/create chooser. -- COMMAND: dedicated app session.')
        return
    if not shutil.which('tmux'):
        raise RuntimeError('Missing dependency: tmux')
    # A client inside its own server would mirror itself; switch sessions instead.
    if Path(os.environ.get('TMUX', '').split(',')[0]).name == SOCKET:
        raise RuntimeError('Already in a t session; use Ctrl+S then s to switch')
    # Inside another tmux (Cloud Shell's, or a local one over SSH) this starts
    # a nested client on the dedicated server; its prefix is Ctrl+S.
    os.environ.pop('TMUX', None)
    os.environ.pop('TMUX_PANE', None)
    args = sys.argv[1:]
    if args:
        if args[0] != '--' or len(args) == 1:
            raise RuntimeError('Expected -- COMMAND [ARG ...]; use --help for usage')
        # tmux treats bare/trailing semicolons as its own command separators even
        # after --. Pass one shell-command with every application argument quoted.
        # Arguments are never evaluated as shell syntax.
        execute('new-session', '-s', 'app-' + uuid.uuid4().hex[:12],
                '-c', str(Path.cwd()), '--', 'exec ' + shlex.join(args[1:]))
    if not shutil.which('fzf'):
        raise RuntimeError('Missing dependency: fzf')
    available = sessions()
    if not available:
        create_session()
        return
    options = [(row['id'], f"{row['name']}  ({row['windows']} windows; "
                f"{str(row['busy']) + ' attached' if row['busy'] else 'detached'})")
               for row in available]
    options.append(('new', '+ Create new session'))
    selected = choose(options, 'Session > ', 'Resume a project or create one · Esc cancels')
    if selected is None:
        return
    if selected == 'new':
        create_session()
        return
    # Refresh attachment state after the chooser; sessions can change meanwhile.
    session = next((row for row in sessions() if row['id'] == selected), None)
    if session is None:
        raise RuntimeError('That session ended. Run t again to refresh.')
    if session['busy']:
        action = choose([('view', 'Independent view — shared tabs, independent tab selection'),
                         ('join', 'Join existing session — synchronized tab selection')],
                        'Open > ', f"{session['name']} is already attached")
        if action is None:
            return
        if action == 'view':
            name = 'view-' + uuid.uuid4().hex[:12]
            # Configure the view after the new client attaches. Setting
            # destroy-unattached on a detached session would destroy it at once.
            execute('new-session', '-t', selected, '-s', name,
                    ';', 'set-option', '-t', name, '@dotfiles-view', '1',
                    ';', 'set-option', '-t', name, 'destroy-unattached', 'on')
    execute('attach-session', '-t', selected)


if __name__ == '__main__':
    try:
        main()
    except (EOFError, KeyboardInterrupt):
        pass
    except (OSError, RuntimeError) as error:
        print(f'dotfiles-tmux: {error}', file=sys.stderr)
        sys.exit(1)
