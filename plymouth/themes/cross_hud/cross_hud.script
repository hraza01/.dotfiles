# cross_hud — custom Plymouth boot splash
# Frames: 210 PNGs (progress-0..209.png), cycled at 3 frames per tick.
# Background: pure black. On boot completion or shutdown: finishes
# the current loop at accelerated speed, then fades to opacity 0.
# Guarantees at least one full cycle before fading.

# Background
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

# Screen dimensions
screen.w = Window.GetWidth(0);
screen.h = Window.GetHeight(0);
screen.half.w = screen.w / 2;
screen.half.h = screen.h / 2;

# State
frame_count = 210;
frame_index = 0;
boot_progress = 0.0;
finishing = 0;
fading = 0;
fade_opacity = 1.0;
cycles_completed = 0;

# Load animation frames
for (i = 0; i < frame_count; i++)
  frame_image[i] = Image("progress-" + i + ".png");

frame_sprite = Sprite();
frame_sprite.SetX(Window.GetX() + (screen.half.w - frame_image[0].GetWidth() / 2));
frame_sprite.SetY(Window.GetY() + (screen.half.h - frame_image[0].GetHeight() / 2));
frame_sprite.SetOpacity(1.0);

# --- Refresh: drive the animation each frame ---
fun refresh_callback ()
  {
    if (fading)
      {
        fade_opacity = fade_opacity - 0.05;
        if (fade_opacity < 0)
          fade_opacity = 0;
        frame_sprite.SetOpacity(fade_opacity);
      }
    else if (finishing && cycles_completed >= 1)
      {
        # Fast-forward: 15 frames per tick to finish the loop quickly
        frame_sprite.SetImage(frame_image[frame_index]);
        frame_index = frame_index + 15;
        if (frame_index >= frame_count)
          {
            frame_index = frame_count - 1;
            fading = 1;
          }
      }
    else
      {
        # Normal playback: 3 frames per tick
        frame_sprite.SetImage(frame_image[frame_index]);
        frame_index = frame_index + 3;
        if (frame_index >= frame_count)
          {
            frame_index = 0;
            cycles_completed = cycles_completed + 1;
          }
      }
  }

Plymouth.SetRefreshFunction(refresh_callback);

# --- Boot progress: detect when boot is nearly complete ---
fun boot_progress_callback (duration, progress)
  {
    boot_progress = progress;
    if (progress >= 0.9)
      finishing = 1;
  }

Plymouth.SetBootProgressFunction(boot_progress_callback);

# --- Quit: start finishing, but ensure at least one cycle ---
fun quit_callback ()
  {
    finishing = 1;
  }

Plymouth.SetQuitFunction(quit_callback);

# --- Password prompt ---
bullet.image = Image.Text("*", 1, 1, 1);
prompt = null;
bullets = null;

fun display_password_callback (nil, bulletCount)
  {
    prompt.image = Image.Text("Enter Password", 1, 1, 1);
    prompt.sprite = Sprite(prompt.image);
    prompt.sprite.SetX(screen.half.w - prompt.image.GetWidth() / 2);
    prompt.sprite.SetY(screen.h - 4 * prompt.image.GetHeight());

    bullets = null;
    totalWidth = bulletCount * bullet.image.GetWidth();
    startPos = screen.half.w - totalWidth / 2;
    for (i = 0; i < bulletCount; i++)
      {
        bullets[i].sprite = Sprite(bullet.image);
        bullets[i].sprite.SetX(startPos + i * bullet.image.GetWidth());
        bullets[i].sprite.SetY(screen.h - 2 * bullet.image.GetHeight());
      }
  }

Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback ()
  {
    bullets = null;
    prompt = null;
  }

Plymouth.SetDisplayNormalFunction(display_normal_callback);
