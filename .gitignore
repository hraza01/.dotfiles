/pi/agent/sessions/
/pi/agent/trust.json
/pi/agent/models-store.json

# Local display profiles and recovery copies (not public templates/assets).
sway/.config/sway/profiles/
kanshi/.config/kanshi/*.local
*.before-dotfiles-*
*.orig
*.rej
/deployment-logs/
/deployment.log
/screenshots-private/
/runtime/
