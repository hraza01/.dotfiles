configuration {
    modi: "drun,window,run";
    show: "drun";
    font: "Titillium Web 10";
    dpi: 96;
    terminal: "wezterm";
    icon-theme: "Adwaita";
    drun-display-format: "{name}";
    window-format: "{w}  {t}";
    scroll-method: 0;
    cycle: true;
    sidebar-mode: false;
    show-icons: true;
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
    steal-focus: false;
}

// Replace the default theme, including its light row-state colors.
@theme "theme.rasi"
