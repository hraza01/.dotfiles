* {
    bg: #0d0d0d;
    accent: #4c7899;
    accent-dim: rgba(76, 120, 153, 0.16);
    fg: #ffffff;
    fg-dim: #888888;

    background-color: transparent;
    text-color: var(fg);
    border-color: #333333;
    border: 0;
    border-radius: 0;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    location: center;
    anchor: center;
    width: 480px;
    border: 2px;
    border-radius: 12px;
    padding: 6px;
    background-color: var(bg);
}

mainbox {
    children: [ "inputbar", "message", "listview" ];
    spacing: 4px;
}

inputbar {
    children: [ "entry" ];
    padding: 6px 10px;
}

entry {
    placeholder: "Search";
    placeholder-color: var(fg-dim);
}

listview {
    lines: 12;
    columns: 1;
    cycle: true;
    dynamic: true;
    fixed-height: false;
    scrollbar: false;
    layout: vertical;
}

element {
    padding: 3px 8px;
    spacing: 6px;
    border: 0px 0px 0px 2px;
    border-color: transparent;
    border-radius: 4px;
}

element selected {
    background-color: var(accent-dim);
    border-color: var(accent);
}

element-icon {
    size: 15px;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    highlight: none;
}
