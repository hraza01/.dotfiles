# Read `man 5 sway` for a complete reference.

### General
font pango:Titillium Web SemiBold 12
default_border pixel 2
default_floating_border pixel 2
gaps inner 1
gaps outer 1

# Docked: move workspaces off the internal panel. Undocked: also sleep.
# Requires HandleLidSwitch=ignore in logind; repeat in each binding mode.
bindswitch --locked lid:on  exec ~/.config/sway/scripts/lid-close.sh
bindswitch --locked lid:off output eDP-1 enable

### Variables
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

# Terminal
set $term wezterm

### Output configuration
# Display mode/position/scale are managed by kanshi (see ~/.config/kanshi/config).
# These lines only set properties kanshi does not manage (subpixel, scale_filter).
output "Dell Inc. DELL U3223QE J4MZ4P3" scale_filter smart subpixel rgb
output "Dell Inc. DELL U3223QE 44MZ4P3" scale_filter smart subpixel rgb
output eDP-1 scale_filter smart subpixel bgr

# Solid background (swaybg).
output * bg #000000 solid_color

### Autostart
# Keep D-Bus-activated applications consistent with the compositor environment.
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XCURSOR_THEME XCURSOR_SIZE TERMINAL PATH
# Quickshell owns notifications after the documented Dunst handoff.
# Polkit's GNOME-only autostart needs an explicit exec.
exec quickshell -n
exec kanshi
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
# Applet backends for the dedicated Quickshell network/Bluetooth menus.
exec nm-applet
exec blueman-applet
# Start once per session: reloads must not add another IPC listener.
# Supply pipx's bin directory to this child, including at a fresh SDDM login.
exec env PATH="${PIPX_BIN_DIR:-$HOME/.local/bin}:$PATH" autotiling -w 1 3 5 7 9

### Idle configuration
# Lock after 5 min idle, display off after 10 min, lock before sleep.
exec swayidle -w \
         timeout 300 'gtklock -d -s "$HOME/.config/gtklock/style.css" -x "$HOME/.config/gtklock/layout.xml"' \
         timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
         before-sleep 'gtklock -d -s "$HOME/.config/gtklock/style.css" -x "$HOME/.config/gtklock/layout.xml"'

### Input configuration
# Caps Lock -> Escape (real Escape key still works). Applies to all keyboards.
  input "type:keyboard" {
      xkb_layout us
      xkb_options caps:escape
  }

  input "type:touchpad" {
      dwt enabled
      tap enabled
      natural_scroll enabled
      middle_emulation enabled
  }

# Cursor theme (seat config for sway's own cursor).
  seat "seat0" xcursor_theme Bibata-Original-Classic 24

### Key bindings
#
# Basics:
#
    # Start a terminal
    bindsym Ctrl+Return exec $term

    # Kill focused window
    bindsym $mod+w kill

    # Launcher (quickshell)
    bindsym Mod1+space exec qs ipc call launcher toggle

    # File manager (Nautilus)
    bindsym $mod+Shift+f exec nautilus

    # Drag floating windows by holding $mod and left mouse button.
    # Resize with right mouse button + $mod.
    # Also works for non-floating windows.
    # Change normal to inverse to swap left/right mouse button roles.
    floating_modifier $mod normal

    # Reload both owners without another shell process (WezTerm uses Alt+Z).
    bindsym $mod+Shift+c reload, exec qs ipc call shell reload

    # Lock screen
    bindsym $mod+Shift+q exec 'gtklock -d -s "$HOME/.config/gtklock/style.css" -x "$HOME/.config/gtklock/layout.xml"'

    # Exit sway: enter confirm mode, then press e to exit or Esc to cancel
    bindsym $mod+Shift+e mode "exit"

    # Hardware controls use brightnessctl/wpctl with best-effort Quickshell OSD IPC.
    bindsym XF86MonBrightnessUp   exec ~/.config/sway/scripts/brightness.sh 5%+
    bindsym XF86MonBrightnessDown exec ~/.config/sway/scripts/brightness.sh 5%-
    bindsym XF86AudioRaiseVolume  exec ~/.config/sway/scripts/volume.sh up
    bindsym XF86AudioLowerVolume  exec ~/.config/sway/scripts/volume.sh down
    bindsym XF86AudioMute         exec ~/.config/sway/scripts/volume.sh mute
#
# Moving around:
#
    # Move focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    # Or use $mod+[up|down|left|right]
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    # Same, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right
#
# Workspaces:
#
    # Switch to workspace
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10

    # Move focused container to workspace
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10
#
# Layout stuff:
#
    # Split the focused container horizontally ($mod+b) or vertically ($mod+v)
    bindsym $mod+b splith
    bindsym $mod+v splitv

    # Switch the current container between different layout styles
    bindsym $mod+s layout stacking
    bindsym $mod+t layout tabbed
    bindsym $mod+e layout toggle split

    # Make the current focus fullscreen
    bindsym $mod+f fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Shift+space floating toggle

    # Move focus to the parent container
    bindsym $mod+a focus parent
#
# Scratchpad:
#
    # Scratchpad: hidden window storage. Send windows there and recall later.

    # Move focused window to scratchpad
    bindsym $mod+Shift+minus move scratchpad

    # Cycle through scratchpad windows
    bindsym $mod+minus scratchpad show
#
# Screenshots:
#
    bindsym {
        # Capture the currently active output to clipboard
        Shift+Print exec grimshot copy output

        # Capture the currently active window
        Mod1+p exec grimshot save active
        # Capture the currently active window to clipboard
        Shift+Mod1+p exec grimshot copy active

        # Select and capture a custom rectangular area
        $mod+Shift+s exec grimshot save area
        # Select and capture a custom rectangular area to clipboard
        $mod+Shift+Ctrl+s exec grimshot copy area

        # Select an area and open it in swappy for annotation/editing
        Print exec grimshot save area - | swappy -f -
    }

#
# Resizing containers:
#
mode "resize" {
    bindswitch --locked lid:on  exec ~/.config/sway/scripts/lid-close.sh
    bindswitch --locked lid:off output eDP-1 enable

    # left/right shrink/grow width, up/down shrink/grow height
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    # Same, with arrow keys
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Exit confirmation mode: press e to exit, Esc/Return to cancel
mode "exit" {
    bindswitch --locked lid:on  exec ~/.config/sway/scripts/lid-close.sh
    bindswitch --locked lid:off output eDP-1 enable

    bindsym e exec swaymsg exit
    bindsym Escape mode "default"
    bindsym Return mode "default"
    bindsym $mod+Shift+e mode "default"
}

### Desktop settings
set $gnome-schema org.gnome.desktop.interface
exec_always {
    gsettings set org.gnome.desktop.wm.preferences theme 'adw-gtk3-dark'
    gsettings set $gnome-schema gtk-theme 'adw-gtk3-dark'
    gsettings set $gnome-schema icon-theme 'Adwaita'
    gsettings set $gnome-schema color-scheme 'prefer-dark'
    # GTK4/libadwaita use this preference rather than GTK3's settings.ini.
    gsettings set $gnome-schema font-name 'Titillium Web SemiBold 12'
    # Reapply kanshi's mode/scale/position policy after a Sway reload.
    pkill -SIGHUP kanshi
}

include /etc/sway/config.d/*
include ~/.config/sway/config.d/*.conf
