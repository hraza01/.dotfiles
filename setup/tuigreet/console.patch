+  #[tokio::test]
+  async fn console_escape_preserves_conversation() {
+    use greetd_ipc::{Request, codec::TokioCodec};
+    use tokio::{net::UnixStream, time::{timeout, Duration}};
+    for mode in [Mode::Username, Mode::Password] {
+      for secret in [false, true] {
+        let (client, mut server) = UnixStream::pair().unwrap();
+        let stream = Arc::new(RwLock::new(client));
+        let mut g = console_state(mode);
+        g.asking_for_secret = secret;
+        g.stream = Some(stream.clone());
+        let g = Arc::new(RwLock::new(g));
+        handle(g.clone(), KeyEvent::new(KeyCode::Esc, KeyModifiers::NONE), Ipc::new()).await.unwrap();
+        let state = g.read().await;
+        assert_eq!(state.mode, mode);
+        assert_eq!(state.username.value, "alice");
+        assert!(state.buffer.is_empty());
+        assert_eq!(state.prompt.as_deref(), Some("Verification code:"));
+        assert_eq!(state.message.as_deref(), Some("failed"));
+        assert_eq!(state.asking_for_secret, secret);
+        assert_eq!(state.cursor_offset, if mode == Mode::Password { 0 } else { -2 });
+        assert!(Arc::ptr_eq(state.stream.as_ref().unwrap(), &stream));
+        assert!(timeout(Duration::from_millis(20), Request::read_from(&mut server)).await.is_err());
+      }
+    }
+  }
+
+  #[tokio::test]
+  async fn console_reset_cancels_and_reconnects() {
+    use greetd_ipc::{Request, codec::TokioCodec};
+    use tokio::{net::{UnixListener, UnixStream}, time::{timeout, Duration}};
+    for mode in [Mode::Username, Mode::Password] {
+      let dir = tempfile::tempdir().unwrap();
+      let path = dir.path().join("greetd.sock");
+      let listener = UnixListener::bind(&path).unwrap();
+      let (client, mut server) = UnixStream::pair().unwrap();
+      let mut g = console_state(mode);
+      g.socket = path.to_str().unwrap().into();
+      g.stream = Some(Arc::new(RwLock::new(client)));
+      let g = Arc::new(RwLock::new(g));
+      timeout(Duration::from_secs(1), handle(g.clone(),
+        KeyEvent::new(KeyCode::Char('u'), KeyModifiers::CONTROL), Ipc::new())).await.unwrap().unwrap();
+      let request = timeout(Duration::from_secs(1), Request::read_from(&mut server)).await.unwrap().unwrap();
+      assert!(matches!(request, Request::CancelSession));
+      let (mut fresh, _) = timeout(Duration::from_secs(1), listener.accept()).await.unwrap().unwrap();
+      let state = g.read().await;
+      assert_eq!(state.mode, Mode::Username);
+      assert_eq!(state.previous_mode, Mode::Username);
+      assert!(state.username.value.is_empty());
+      assert!(state.buffer.is_empty());
+      assert!(state.previous_buffer.is_none());
+      assert!(state.message.is_none());
+      assert!(state.prompt.is_none());
+      assert_eq!(state.cursor_offset, 0);
+      assert!(!state.working && !state.done && !state.asking_for_secret);
+      assert!(timeout(Duration::from_millis(20), Request::read_from(&mut fresh)).await.is_err());
+    }
+  }
+
+  #[tokio::test]
+  async fn console_busy_shortcuts_are_ignored() {
+    for key in [KeyEvent::new(KeyCode::Esc, KeyModifiers::NONE),
+      KeyEvent::new(KeyCode::Char('u'), KeyModifiers::CONTROL)] {
+      let mut g = console_state(Mode::Password);
+      g.working = true;
+      let g = Arc::new(RwLock::new(g));
+      handle(g.clone(), key, Ipc::new()).await.unwrap();
+      let state = g.read().await;
+      assert_eq!(state.mode, Mode::Password);
+      assert_eq!(state.username.value, "alice");
+      assert_eq!(state.buffer, "response");
+      assert_eq!(state.previous_buffer.as_deref(), Some("saved response"));
+      assert_eq!(state.message.as_deref(), Some("failed"));
+      assert_eq!(state.cursor_offset, -2);
+    }
+  }
+
+  #[tokio::test]
+  async fn console_menus_keep_upstream_back_and_clear() {
+    for mode in [Mode::Command, Mode::Users, Mode::Sessions, Mode::Power, Mode::Background] {
+      let g = Arc::new(RwLock::new(console_state(mode)));
+      handle(g.clone(), KeyEvent::new(KeyCode::Char('u'), KeyModifiers::CONTROL), Ipc::new()).await.unwrap();
+      {
+        let state = g.read().await;
+        assert_eq!(state.mode, mode);
+        assert_eq!(state.buffer, if mode == Mode::Command { "" } else { "response" });
+        assert_eq!(state.username.value, "alice");
+      }
+      handle(g.clone(), KeyEvent::new(KeyCode::Esc, KeyModifiers::NONE), Ipc::new()).await.unwrap();
+      let state = g.read().await;
+      assert_eq!(state.mode, Mode::Password);
+      assert_eq!(state.buffer, if mode == Mode::Command { "saved response" } else { "response" });
+    }
+  }
