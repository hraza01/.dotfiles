// -*- mode: jsonc -*-
{
  "height": 31,
  "spacing": 2,
  "modules-left": [
    "custom/arch",
    "sway/workspaces",
    "sway/mode",
    "sway/scratchpad",
  ],
  "modules-center": [],
  "modules-right": [
    "idle_inhibitor",
    "cpu",
    "memory",
    "backlight",
    "pulseaudio",
    "network",
    "bluetooth",
    "custom/power-profile",
    "custom/clock",
  ],

  // Static Arch Linux mark (Font Awesome Brands 7.2+, U+E867).
  "custom/arch": {
    "format": "\ue867",
    "tooltip-format": "Arch Linux",
  },

  "sway/mode": {
    "format": "<span style=\"italic\">{}</span>",
  },
  "sway/scratchpad": {
    "format": "<span font_desc=\"15px\" weight=\"normal\">{icon}</span> {count}",
    "show-empty": false,
    "format-icons": ["\uf073", "\uf24d"],
    "tooltip": true,
    "tooltip-format": "{app}: {title}",
  },

  // Click to toggle presentation mode (disables idle).
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "\uf06e",
      "deactivated": "\uf070",
    },
  },

  "custom/clock": {
    // Time in the bar; hover shows a calendar (JetBrains Mono grid,
    // today highlighted).
    "exec": "$HOME/.config/waybar/scripts/clock.sh",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "interval": 30,
  },

  "cpu": {
    // Icon only; per-core usage shown on hover.
    "format": "\uf2db",
    "tooltip": true,
  },
  "memory": {
    // Icon only; memory breakdown shown on hover.
    "format": "\uf0c9",
    "tooltip": true,
    "tooltip-format": "Memory: {percentage}%\n{used}GiB / {total}GiB",
  },
  "backlight": {
    // Icon only; scroll directly on the module to adjust brightness
    // (waybar's built-in default scroll behavior, no external script).
    "format": "\uf185",
    "tooltip": true,
    "tooltip-format": "Brightness: {percent}%",
    "scroll-step": 5,
  },
  "custom/power-profile": {
    // Icon in the bar; hover shows profile + driver + battery %.
    // Click cycles available profiles: performance -> balanced -> power-saver.
    "exec": "$HOME/.config/waybar/scripts/power.sh",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "interval": 30,
    "on-click": "$HOME/.config/waybar/scripts/power-cycle.sh",
    "exec-on-event": true,
  },

  "network": {
    "tooltip": true,
    "format-wifi": "\uf1eb",
    "format-ethernet": "{ipaddr}/{cidr} <span font_desc=\"15px\" weight=\"normal\">\uf796</span>",
    "tooltip-format": "{essid} ({signalStrength}%) | {ifname}: {ipaddr}/{cidr} via {gwaddr}",
    "format-linked": "{ifname} (No IP) <span font_desc=\"15px\" weight=\"normal\">\uf796</span>",
    "format-disconnected": "Disconnected <span font_desc=\"15px\" weight=\"normal\">\u26a0</span>",
    // Click opens the editor without replacing the Wi-Fi icon with an IP.
    "on-click": "nm-connection-editor",
  },
  "bluetooth": {
    // Icon only; connected device shown on hover.
    "format": "\uf293",
    "format-disabled": "\uf293",
    "format-off": "\uf293",
    "tooltip-format": "{status} | {num_connections} connected",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias} ({device_address})",
    "on-click": "blueman-manager",
  },
  "pulseaudio": {
    // Icon only; volume + source shown on hover. Scroll to adjust volume.
    "format": "{icon}",
    "format-bluetooth": "{icon}",
    "format-bluetooth-muted": "\uf6a9 {icon}",
    "format-muted": "\uf6a9",
    "format-source": "\uf3cd",
    "format-source-muted": "\uf131",
    "tooltip-format": "Volume: {volume}%\nSource: <span font_desc=\"15px\" weight=\"normal\">{format_source}</span>",
    "scroll-step": 5,
    "format-icons": {
      "headphone": "\uf025",
      "hands-free": "\uf025",
      "headset": "\uf025",
      "phone": "\uf3cd",
      "portable": "\uf3cd",
      "car": "\uf1b9",
      "default": ["\uf026", "\uf027", "\uf028"],
    },
    "on-click": "pavucontrol",
  },
}
