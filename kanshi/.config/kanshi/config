# kanshi - optional private display profiles (man 5 kanshi)
# No public profile forces connector names, modes, scale, or output enablement.
# With no profiles, the compositor retains its current/default layout.
#
# Create ~/.config/dotfiles-private/kanshi.conf outside the checkout, then
# uncomment the include below. Keep that directory private and outside Stow.
# An explicit opt-in avoids an include error when the private file is absent.
# include ~/.config/dotfiles-private/kanshi.conf
#
# Private profile template (replace placeholders only in the private file):
# profile docked {
#     output "<manufacturer model serial>" mode preferred scale 1
# }
# Kanshi owns mode/position/scale; panel-specific subpixel/filter settings belong
# in ~/.config/dotfiles-private/sway/*.conf. Review before any live reload.
