# Arch Ghostty + tmux project sessions; requires Ghostty 1.3+.
# Keep unspecified Ghostty defaults, including its secondary keybindings.

# Fonts: same primary/fallback families and disabled ligatures.
font-family = JetBrainsMono Nerd Font Mono
font-family = JetBrains Mono
font-size = 12
font-feature = calt=0
font-feature = liga=0

# GTK uses Wayland in the Sway session; let Sway draw its pixel borders.
window-decoration = server
gtk-titlebar = false
# Applies to every new window, including Sway's Super+Return and Ctrl+Shift+N.
command = shell:exec "$HOME/.local/bin/dotfiles-tmux"
# Outer terminal padding in points; tmux adds no padding inside its panes.
window-padding-x = 3
# Keep top padding but bring tmux's bottom status bar closer to the window edge.
window-padding-y = 3,0
window-padding-balance = true
background-opacity = 0.83
background-opacity-cells = false

# tmux owns the bottom window strip and rename prompt.
window-show-tab-bar = never
# Remove native tab/split creation from the palette and context menu as well.
# Ghostty has no global switch disabling the underlying native actions.
right-click-action = ignore
config-file = tmux-palette.ghostty
# Minimal black native alerts (configuration errors, clipboard prompts, etc.).
gtk-custom-css = dialogs.css

# Keep a steady block at the prompt, not shell integration's default bar.
cursor-style = block
cursor-style-blink = false
# Use xterm-256color over SSH without installing terminfo on remote hosts.
shell-integration-features = no-cursor,ssh-env,no-ssh-terminfo
cursor-color = #BCB8B4
cursor-text = #000000
split-divider-color = #555555
# Hide the dimensions popup when creating/closing panes or resizing windows.
resize-overlay = never

# WezTerm's default foreground/ANSI palette plus the explicit black override.
# Ghostty's defaults (and its bundled "Wez" theme) are not an exact match.
background = #000000
foreground = #b2b2b2
palette = 0=#000000
palette = 1=#cc5555
palette = 2=#55cc55
palette = 3=#cdcd55
palette = 4=#5455cb
palette = 5=#cc55cc
palette = 6=#7acaca
palette = 7=#cccccc
palette = 8=#555555
palette = 9=#ff5555
palette = 10=#55ff55
palette = 11=#ffff55
palette = 12=#5555ff
palette = 13=#ff55ff
palette = 14=#55ffff
palette = 15=#ffffff
palette-generate = false
bold-color = bright
minimum-contrast = 1

# No confirmation for tab, pane, or window closes, even with running jobs.
confirm-close-surface = false

# tmux windows and splits. Each sequence sends the Ctrl+S prefix first.
keybind = ctrl+t=text:\x13c
keybind = ctrl+shift+t=text:\x13c
keybind = ctrl+w=text:\x13&
keybind = ctrl+shift+w=text:\x13x
keybind = alt+shift+r=text:\x13,
keybind = ctrl+shift+r=text:\x13,
keybind = alt+d=text:\x13|
keybind = alt+shift+d=text:\x13-
keybind = ctrl+shift+o=text:\x13|
keybind = ctrl+shift+e=text:\x13-
keybind = alt+w=text:\x13x
keybind = ctrl+shift+enter=text:\x13m
keybind = ctrl+tab=text:\x13\x0e
keybind = ctrl+shift+tab=text:\x13p
keybind = ctrl+page_down=text:\x13\x0e
keybind = ctrl+page_up=text:\x13p
keybind = ctrl+shift+left=text:\x13p
keybind = ctrl+shift+right=text:\x13\x0e
keybind = alt+1=text:\x131
keybind = alt+2=text:\x132
keybind = alt+3=text:\x133
keybind = alt+4=text:\x134
keybind = alt+5=text:\x135
keybind = alt+6=text:\x136
keybind = alt+7=text:\x137
keybind = alt+8=text:\x138
keybind = alt+9=text:\x139
keybind = alt+digit_1=text:\x131
keybind = alt+digit_2=text:\x132
keybind = alt+digit_3=text:\x133
keybind = alt+digit_4=text:\x134
keybind = alt+digit_5=text:\x135
keybind = alt+digit_6=text:\x136
keybind = alt+digit_7=text:\x137
keybind = alt+digit_8=text:\x138
keybind = alt+digit_9=text:\x139

# Readline navigation: Ctrl+arrows for line ends; Alt+arrows for words.
keybind = ctrl+left=text:\x01
keybind = ctrl+right=text:\x05
keybind = alt+left=esc:b
keybind = alt+right=esc:f
keybind = alt+backspace=text:\x1b\x7f

keybind = alt+h=text:\x13h
keybind = alt+j=text:\x13j
keybind = alt+k=text:\x13k
keybind = alt+l=text:\x13l
keybind = alt+shift+h=text:\x13H
keybind = alt+shift+j=text:\x13J
keybind = alt+shift+k=text:\x13K
keybind = alt+shift+l=text:\x13L
keybind = ctrl+alt+left=text:\x13h
keybind = ctrl+alt+down=text:\x13j
keybind = ctrl+alt+up=text:\x13k
keybind = ctrl+alt+right=text:\x13l
keybind = ctrl+alt+shift+left=text:\x13H
keybind = ctrl+alt+shift+down=text:\x13J
keybind = ctrl+alt+shift+up=text:\x13K
keybind = ctrl+alt+shift+right=text:\x13L
keybind = super+ctrl+[=text:\x13;
keybind = super+ctrl+]=text:\x13o
keybind = super+ctrl+shift+left=text:\x13H
keybind = super+ctrl+shift+down=text:\x13J
keybind = super+ctrl+shift+up=text:\x13K
keybind = super+ctrl+shift+right=text:\x13L
keybind = alt+shift+z=reload_config

# Copy only when selected; otherwise Ctrl+C reaches the running program.
keybind = performable:ctrl+c=copy_to_clipboard:mixed
# Paste is handled in zsh / Neovim insert mode so normal-mode Ctrl+V still
# enters visual block. Ctrl+Shift+V remains Ghostty's universal paste binding.
keybind = ctrl+v=unbind

# Leave these to the application/compositor.
keybind = alt+enter=unbind
keybind = super+w=unbind
# Ctrl+Shift+N opens another outer Ghostty window on the most recent session.
